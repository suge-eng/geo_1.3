<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geo.mapper.TaskReportMapper">
    
    <select id="selectByTaskNo" resultType="com.geo.entity.TaskReport">
        SELECT * FROM task_report WHERE task_no = #{taskNo} ORDER BY report_date DESC
    </select>
    
</mapper>
