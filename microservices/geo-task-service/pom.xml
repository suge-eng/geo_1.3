<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geo</groupId>
        <artifactId>geo-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <!--
      任务服务（geo-task-service，端口 8081）—— 系统的“任务调度中心”。
      职责：接收前端提交的任务（含 Excel 题目清单），把任务拆成「1 个问题 × 1 个 AI」的最小单元，
            维护任务/问题/结果的状态，统计进度，并生成排行榜与汇总结果。
    -->
    <artifactId>geo-task-service</artifactId>
    <name>geo-task-service</name>
    <description>GEO Task Microservice (port 8081)</description>

    <dependencies>
        <!-- 引用本项目公共模块，复用实体/DTO/Mapper -->
        <dependency>
            <groupId>com.geo</groupId>
            <artifactId>geo-common</artifactId>
        </dependency>

        <!-- Web 能力：提供 REST 接口、内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 请求参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Redis：缓存任务进度、账号池、分布式锁等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Plus：数据库 ORM 框架 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动；scope=runtime 表示只需运行期存在，编译期不直接用 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Hutool 工具库；排除其自带的 commons-compress，改用下面单独声明的版本 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-compress</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Apache POI：解析 .xls 旧版 Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
        </dependency>

        <!-- Apache POI-OOXML：解析 .xlsx 新版 Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- 解压上传的 zip/rar 压缩包（供解析 Excel 之类使用） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>

        <!-- 单元测试依赖，只在 test 阶段生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>geo-task-service</finalName>   <!-- 最终生成的 jar 文件名 -->
        <plugins>
            <!-- Spring Boot 打包插件：把工程打成可独立运行的 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
