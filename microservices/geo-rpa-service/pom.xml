<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geo</groupId>
        <artifactId>geo-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
      RPA 服务（geo-rpa-service）—— 系统与“抓取 worker 脚本”之间的桥梁。
      对外提供三类 HTTP 接口：任务认领（claim）、心跳（heartbeat）、结果回调（callback）。
      worker 脚本（Python/自动化脚本）通过这三个接口来领取任务、报告存活、回传 AI 抓取结果。
      同时这里还承担「卡住任务」的检测与邮件告警，以及数据库建表脚本(schema)的管理。
    -->
    <artifactId>geo-rpa-service</artifactId>
    <version>1.0.0</version>
    <name>geo-rpa-service</name>
    <description>RPA Micro Service</description>

    <dependencies>
        <!-- 项目公共模块（实体/DTO/Mapper） -->
        <dependency>
            <groupId>com.geo</groupId>
            <artifactId>geo-common</artifactId>
        </dependency>

        <!-- Web 能力：提供认领/心跳/回调等 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 回调请求体参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Redis：与任务服务共享账号池/任务租约等状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- AOP：用于给 worker 的认领/收盘接口做横切逻辑（如标记处理耗时） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 用于「卡住任务」邮件通知 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- MyBatis-Plus：读写任务/结果/账号等数据表 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动（仅运行期） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MinIO：worker 抓取到的截图/附件要落盘到 MinIO，这里负责上传 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- Hutool 工具库（排除其自带的旧版 commons-compress，统一用下面指定版本） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-compress</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 解压 worker 上传的压缩包（含截图等结果文件） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.25.0</version>
        </dependency>

        <!-- 单元测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>geo-rpa-service</finalName>   <!-- 最终生成的 jar 文件名 -->
        <plugins>
            <!-- Spring Boot 打包插件：打成可独立运行的 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
