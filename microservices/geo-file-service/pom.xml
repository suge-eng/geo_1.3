<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geo</groupId>
        <artifactId>geo-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
      文件服务（geo-file-service）—— 对 MinIO 的一层“代理封装”。
      前端与其他服务通过它来上传/下载文件，它内部再与 MinIO 交互，
      好处是屏蔽 MinIO 细节、便于统一做访问控制与路径约定。
      本身不依赖数据库，仅依赖公共模块 + Web + MinIO。
    -->
    <artifactId>geo-file-service</artifactId>
    <name>geo-file-service</name>
    <description>Geo File Proxy Service</description>

    <dependencies>
        <!-- 项目公共模块 -->
        <dependency>
            <groupId>com.geo</groupId>
            <artifactId>geo-common</artifactId>
        </dependency>
        <!-- Web 能力：提供文件上传/下载 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MinIO 对象存储客户端：真正执行文件的读写 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- Knife4j API 文档（嵌入式，服务启动后访问 /doc.html） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <!-- 单元测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>geo-file-service</finalName>   <!-- 最终生成的 jar 文件名 -->
        <plugins>
            <!-- Spring Boot 打包插件：打成可独立运行的 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>